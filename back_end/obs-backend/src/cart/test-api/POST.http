# 購物車 - POST 範例
@baseUrl = http://localhost:3000

# 請替換為有效的 User access_token
@userToken = eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJzdWIiOiJkZWI3Y2JjYi05N2Q3LTQwNjktYTExOC05M2M0MjE0NTM5NTkiLCJhY2NvdW50IjoidXNlcjEiLCJ0eXBlIjoidXNlciIsImlhdCI6MTc2NzAxNDI1MiwiZXhwIjoxNzY3MTAwNjUyfQ.bxgQ33F0Dx_H7NKMACs7pf7m42ZJ98A-S05WZ6q463g

# 請替換為實際書籍 ID（可先用 GET /books 查詢）
@bookId1 = 1deaf535-0d31-40be-8e8e-cbffc3a130a0
@bookId2 = 1ebf638a-7156-4e57-ba37-2f498800cb43

### 新增一筆商品到購物車
POST {{baseUrl}}/cart
Content-Type: application/json
Authorization: Bearer {{userToken}}

{
  "bookID": "{{bookId1}}",
  "quantity": 1
}

### 再次新增同一本書（應累加數量）
POST {{baseUrl}}/cart
Content-Type: application/json
Authorization: Bearer {{userToken}}

{
  "bookID": "{{bookId1}}",
  "quantity": 2
}

### 新增另一個商品
POST {{baseUrl}}/cart
Content-Type: application/json
Authorization: Bearer {{userToken}}

{
  "bookID": "{{bookId2}}",
  "quantity": 1
}

### 嘗試超過庫存（預期回 400）
POST {{baseUrl}}/cart
Content-Type: application/json
Authorization: Bearer {{userToken}}

{
  "bookID": "{{bookId1}}",
  "quantity": 999
}
