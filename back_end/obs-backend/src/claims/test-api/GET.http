@baseUrl = http://localhost:3000
@access_token = {{access_token}}   // user access token
@admin_token = {{admin_token}}     // admin access token
@coupon_id = {{coupon_id}}
@member_id = {{member_id}}
@merchant_id = {{merchant_id}}

# User: list my claims
GET {{baseUrl}}/claims/mine
Authorization: Bearer {{access_token}}

###
# Admin: list all claims
GET {{baseUrl}}/claims
Authorization: Bearer {{admin_token}}

###
# Get single claim by couponID (User: only own; Admin: can specify userID)
GET {{baseUrl}}/claims/{{coupon_id}}
Authorization: Bearer {{access_token}}

###
# Admin get claim for specific user (couponID + userID)
GET {{baseUrl}}/claims/{{coupon_id}}?userID={{member_id}}
Authorization: Bearer {{admin_token}}

###
# For checkout: list usable coupons for a merchant
GET {{baseUrl}}/claims/usable?merchantId={{merchant_id}}
Authorization: Bearer {{access_token}}
